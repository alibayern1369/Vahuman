# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL
# Use the pooled connection string for the Next.js runtime (Vercel / serverless).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: direct (non-pooled) connection for migrations via drizzle-kit.
# Prefer this for `pnpm db:migrate` when Neon pooling is enabled.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication (planned — Better Auth)
# Generate a strong random secret before enabling auth in a later phase.
# AUTH_SECRET=

# Future integrations (do not set until needed)
# AI_PROVIDER=
# AI_API_KEY=
# SMS_PROVIDER=
# SMS_API_KEY=
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=
