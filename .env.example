# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL
# Use the pooled connection string for the Next.js runtime (Vercel / serverless).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: direct (non-pooled) connection for migrations.
# Prefer this for `pnpm db:migrate` when Neon pooling is enabled.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth (required for admin login)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public email/password sign-up is enabled for customers by default.
# Set to "true" to disable public registration.
AUTH_DISABLE_SIGNUP=false

# First admin seed — used only by `pnpm db:seed-admin` (never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدیر وهومن

# Future integrations (do not set until needed)
# AI_PROVIDER=
# AI_API_KEY=
# SMS_PROVIDER=
# SMS_API_KEY=
# STORAGE_PROVIDER=local-dev
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# Cron / background jobs (reservation expiration)
# CRON_SECRET=
